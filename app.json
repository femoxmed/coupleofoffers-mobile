{
  "expo": {
    "name": "Couple Of Offers",
    "slug": "couple-of-offers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coupleofoffers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.coupleofoffers.mobile",
      "appleTeamId": "SQ3FWC7Q3B"
    },
    "android": {
      "package": "ng.coupleofoffers.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAF5ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF5ED"
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Couple Of Offers to use your location to show curated experiences and venues near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
